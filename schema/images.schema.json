{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "images"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "namespace": {
      "const": "quay.io/kurs"
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "strategy",
          "source",
          "platform",
          "description",
          "license",
          "test",
          "command",
          "verification",
          "environment"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]{0,127}$"
          },
          "strategy": {
            "enum": [
              "build",
              "mirror"
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference",
              "digest",
              "version",
              "documentation"
            ],
            "properties": {
              "reference": {
                "type": "string",
                "pattern": "^[a-z0-9.-]+(?::[0-9]+)?/[a-zA-Z0-9_./-]+:[a-zA-Z0-9_.-]+$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "documentation": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              }
            }
          },
          "platform": {
            "const": "linux/amd64"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "okd"
            ],
            "properties": {
              "okd": {
                "const": "not-verified"
              }
            }
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "path": {
            "type": "string",
            "pattern": "^/[^\\s]*$"
          },
          "test": {
            "enum": [
              "http",
              "postgres",
              "python",
              "tools",
              "mysql",
              "mariadb",
              "wordpress",
              "phpmyadmin"
            ]
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "version",
              "sha256"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "environment": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "test_database": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "composer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "version",
              "sha256"
            ],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$"
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "strategy": {
                  "const": "build"
                }
              }
            },
            "then": {
              "required": [
                "context"
              ]
            },
            "else": {
              "required": [
                "assessment"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "context"
                    ]
                  },
                  {
                    "required": [
                      "artifact"
                    ]
                  },
                  {
                    "required": [
                      "composer"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
