ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER 0
# Default and tested runtimes are non-root; remove unused privilege-switch helpers.
RUN rm -f /usr/local/bin/gosu /usr/local/bin/su-exec
# mysql-shell is not needed by the SQL server/client and bundled a vulnerable certifi.
RUN microdnf remove -y mysql-shell && microdnf clean all
RUN mkdir -p /var/lib/mysql /var/run/mysqld /var/lib/mysql-files && \
    chgrp -R 0 /var/lib/mysql /var/run/mysqld /var/lib/mysql-files && \
    chmod -R g=u /var/lib/mysql /var/run/mysqld /var/lib/mysql-files
COPY start.sh /usr/local/bin/kurs-mysql
RUN chmod 755 /usr/local/bin/kurs-mysql
ENV MYSQL_ROOT_HOST=localhost
USER 1001
EXPOSE 3306
ENTRYPOINT ["/usr/local/bin/kurs-mysql"]
CMD ["mysqld", "--datadir=/var/lib/mysql/data", "--socket=/tmp/mysql.sock", "--pid-file=/tmp/mysql.pid"]
