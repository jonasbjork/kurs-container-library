ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER 0
WORKDIR /opt/app-root/src
ARG APP_URL
ARG APP_SHA256
RUN curl -fsSL --retry 3 "${APP_URL}" -o /tmp/wordpress.tar.gz && \
    echo "${APP_SHA256}  /tmp/wordpress.tar.gz" | sha256sum -c - && \
    tar -xzf /tmp/wordpress.tar.gz --strip-components=1 -C /opt/app-root/src && \
    rm /tmp/wordpress.tar.gz
COPY wp-config.php /opt/app-root/src/wp-config.php
COPY start.sh /usr/local/bin/kurs-wordpress
COPY php.ini /etc/php.d/99-kurs.ini
COPY php-fpm.conf /etc/php-fpm.d/zz-kurs.conf
RUN chmod 755 /usr/local/bin/kurs-wordpress && \
    chgrp -R 0 /opt/app-root/src && chmod -R g=u /opt/app-root/src && \
    php -r 'exit(extension_loaded("mysqli") ? 0 : 1);'
USER 1001
EXPOSE 8080
CMD ["/usr/local/bin/kurs-wordpress"]
